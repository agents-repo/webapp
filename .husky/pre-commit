#!/usr/bin/env bash

# Load nvm if available (GUI/non-interactive shells often skip shell rc files).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
  nvm use --silent >/dev/null 2>&1 || true
fi

og_template_staged() {
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -qE '^(scripts/og/|scripts/og-image\.mjs)'
}

run_og_if_templates_staged() {
  if ! og_template_staged; then
    return 0
  fi
  echo "[husky] OG template paths staged; running og:generate and og:check" >&2
  if command -v corepack >/dev/null 2>&1; then
    corepack npm run og:generate || return $?
    corepack npm run og:check || return $?
  else
    npm run og:generate || return $?
    npm run og:check || return $?
  fi
  git add public/og-image.jpg public/og-image.src.sha256 public/og/
}

run_checks() {
  run_og_if_templates_staged || return $?
  if command -v corepack >/dev/null 2>&1; then
    corepack npm run lint:all || return $?
    corepack npm run test:sync || return $?
    corepack npm run sync:ide-instructions -- --check
  else
    npm run lint:all || return $?
    npm run test:sync || return $?
    npm run sync:ide-instructions -- --check
  fi
}

if command -v corepack >/dev/null 2>&1 || command -v npm >/dev/null 2>&1; then
  run_checks
  exit $?
fi

echo "[husky] corepack and npm not found in PATH; skipping pre-commit checks in this environment." >&2
exit 0
